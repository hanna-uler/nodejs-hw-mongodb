{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Phonebook App",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "The **Phonebook App** is a RESTful API that allows users to securely manage their personal and professional contacts. This documentation provides a detailed overview of all available endpoints, request/response formats, and authentication requirements."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://hw2-mongodb-07bu.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Endpoints for managing contacts, including creating, retrieving, updating, and deleting contact entries. Supports advanced features such as pagination, sorting, filtering by contact type or favorite status, and uploading a photo for each contact. All contact data is associated with the authenticated user."
    },
    {
      "name": "Auth",
      "description": "Authentication and user session management endpoints. Includes functionality for user registration, login with JWT-based access tokens, secure session handling via HTTP-only cookies, token refresh, logout, and password reset workflow."
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Retrieve a paginated list of user contacts",
        "operationId": "getContacts",
        "description": "Returns a list of contacts associated with the authenticated user. Supports filtering by contact type and favorite status, as well as pagination and sorting by any contact field.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "in": "query",
            "name": "perPage",
            "schema": {
              "type": "integer",
              "example": 10
            }
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": {
              "type": "string",
              "example": "name"
            },
            "description": "Any of contact fields can be mentioned. Default value - _id"
          },
          {
            "in": "query",
            "name": "sortOrder",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "example": "asc"
            }
          },
          {
            "in": "query",
            "name": "contactType",
            "schema": {
              "type": "string",
              "enum": [
                "work",
                "home",
                "personal"
              ],
              "example": "work"
            }
          },
          {
            "in": "query",
            "name": "isFavourite",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully found the contacts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found the contacts."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "data",
                        "page",
                        "perPage",
                        "totalItems",
                        "totalPages",
                        "hasNextPage",
                        "hasPreviousPage"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/contact"
                          }
                        },
                        "page": {
                          "type": "number",
                          "example": 3
                        },
                        "perPage": {
                          "type": "number",
                          "example": 10
                        },
                        "totalItems": {
                          "type": "number",
                          "example": 25
                        },
                        "totalPages": {
                          "type": "number",
                          "example": 3
                        },
                        "hasNextPage": {
                          "type": "boolean",
                          "example": false
                        },
                        "hasPreviousPage": {
                          "type": "boolean",
                          "example": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Add a new contact to the user's contact list",
        "operationId": "createContact",
        "description": "Create a new contact and associate it with the authenticated user. This endpoint supports uploading a contact photo and specifying additional contact details.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "phoneNumber",
                  "contactType"
                ],
                "properties": {
                  "name": {
                    "description": "Full name of the contact. Must be 3-20 characters.",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "Alice Woods"
                  },
                  "phoneNumber": {
                    "description": "Contact's phone number in E.164 format. Must start with an optional `+`, followed by digits (no spaces or dashes). Between 2 and 15 digits.",
                    "type": "string",
                    "pattern": "^\\+?[1-9]\\d{1,14}$",
                    "example": "+13471234567"
                  },
                  "contactType": {
                    "description": "Category of the contact number. Must be one of the following - 'work', 'home', or 'personal'.",
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "personal"
                    ],
                    "example": "work"
                  },
                  "email": {
                    "description": "Optoinal email address of the contact",
                    "type": "string",
                    "example": "alicewoods@example.com"
                  },
                  "isFavourite": {
                    "description": "Indicates if the contact is marked as favorite",
                    "type": "boolean",
                    "example": false
                  },
                  "photo": {
                    "description": "Optional contact photo (JPEG/PNG)",
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contact created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully created a contact!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get contact by id",
        "operationId": "getContact",
        "description": "Get a full contact information using the id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "65ca67e7ae7f10c88b598384"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get contact by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found a contact with id 65ca67e7ae7f10c88b598384!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "patch": {
        "tags": [
          "Contacts"
        ],
        "summary": "Update a contact by ID",
        "operationId": "updateContact",
        "description": "Update one or more fields of a contact with the specified ID. Only the fields provided in the request will be updated.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "65ca67e7ae7f10c88b598384"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Full name of the contact. Optional. Must be between 3 and 20 characters.",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "example": "Alice Woods"
                  },
                  "phoneNumber": {
                    "description": "Phone number in E.164 format. Optional. Must start with an optional `+`, followed by digits only (no spaces or dashes). Between 2 and 15 digits total.",
                    "type": "string",
                    "pattern": "^\\+?[1-9]\\d{1,14}$",
                    "example": "+13471234567"
                  },
                  "contactType": {
                    "description": "Category of the contact number. Optional.",
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "personal"
                    ],
                    "example": "work"
                  },
                  "email": {
                    "description": "Email address of the contact. Optional.",
                    "type": "string",
                    "example": "alicewoods@example.com"
                  },
                  "isFavourite": {
                    "description": "Indicates if the contact is marked as favorite. Optional.",
                    "type": "boolean",
                    "example": false
                  },
                  "userId": {
                    "description": "Automatically injected from the authenticated user. Do not provide this field in the request.",
                    "type": "string",
                    "example": "65e4decdd286b30065d54af9",
                    "readOnly": true
                  },
                  "photo": {
                    "description": "Optional contact photo upload (JPEG/PNG)",
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully updated contact with id 65ca67e7ae7f10c88b598384!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts"
        ],
        "summary": "Delete contact by ID",
        "operationId": "deleteContact",
        "description": "Deletes a contact from the authenticated user's contact list based on the provided contact ID.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "65ca67e7ae7f10c88b598384",
              "description": "Unique identifier of the contact to be deleted."
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Contact deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 204
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully deleted a contact with id 65ca67e7ae7f10c88b598384!"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user",
        "operationId": "registerUser",
        "description": "Creates a new user account. This endpoint requires a **name**, **email**, and **password**.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/userRegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully registered user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully registered a user!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/userCreatedResponse"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "contactType",
          "userId"
        ],
        "properties": {
          "_id": {
            "description": "Contact's id",
            "type": "string",
            "example": "68891682bbed1f94c39c2c10"
          },
          "name": {
            "description": "Name of the contact",
            "type": "string",
            "example": "Alice Woods"
          },
          "phoneNumber": {
            "description": "Phone number of the contact",
            "type": "string",
            "example": 3471234567
          },
          "contactType": {
            "description": "The type of the contact phone number",
            "type": "string",
            "enum": [
              "work",
              "home",
              "personal"
            ]
          },
          "userId": {
            "description": "The contact owner's id",
            "type": "string",
            "example": "687e27369175a01d77ac83eb"
          },
          "email": {
            "description": "The contact's email",
            "type": "string",
            "example": "mgregor@mail.com"
          },
          "isFavourite": {
            "description": "Whether is the contact the user's favorite",
            "type": "boolean",
            "example": false
          },
          "photo": {
            "description": "Link to the contact's photo",
            "type": "string",
            "example": "https://res.cloudinary.com/dhy89urth/image/upload/v1753816248/qt929h100gyv1nlattjc.png"
          }
        }
      },
      "userRegistrationRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "description": "Full name of the user. Must be 3-30 characters.",
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "example": "Alice Woods"
          },
          "email": {
            "description": "User's unique email address. Each email can be registered only ones.",
            "type": "string",
            "example": "alicewoods@example.com"
          },
          "password": {
            "description": "User's password. Must be kept confidential.",
            "type": "string",
            "example": "Nk45Yvs!13t"
          }
        }
      },
      "userCreatedResponse": {
        "type": "object",
        "required": [
          "name",
          "email",
          "_id",
          "password",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "name": {
            "description": "Full name of the user.",
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "example": "Alice Woods"
          },
          "email": {
            "description": "The user's unique email address.",
            "type": "string",
            "example": "awoods@mail.com"
          },
          "_id": {
            "description": "Unique identifier for the user, automatically generated by the database.",
            "type": "string",
            "example": "687e27369175a01d77ac83eb"
          },
          "createdAt": {
            "description": "Date and time when the user account was created (ISO 8601 format, UTC), automatically generated by the database.",
            "type": "string",
            "format": "date-time",
            "example": "2025-07-18T11:00:15.361Z"
          },
          "updatedAt": {
            "description": "Date and time when the user's information was last updated (ISO 8601 format, UTC), automatically generated by the database.",
            "type": "string",
            "format": "date-time",
            "example": "2025-08-11T10:52:15.353Z"
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorized error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message",
                "data"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 401
                },
                "message": {
                  "type": "string",
                  "example": "UnauthorizedError"
                },
                "data": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Access token has been expired"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Page Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message",
                "data"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 404
                },
                "message": {
                  "type": "string",
                  "example": "Page Not Found"
                },
                "data": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Page is Not Found"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "409": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message",
                "data"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 409
                },
                "message": {
                  "type": "string",
                  "example": "Conflict"
                },
                "data": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Email is already in use"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}